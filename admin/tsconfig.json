{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist/admin/src",
    "outDir": "./dist/admin",
    "rootDir": "./src"
  },
  "include": ["./src", "./custom.d.ts"],
  "exclude": ["node_modules", "dist"]
}
